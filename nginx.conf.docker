load_module modules/ndk_http_module.so;
load_module modules/ngx_http_lua_module.so;

worker_processes auto;

events {
    worker_connections 1024;
}

http {
    include       /etc/nginx/mime.types;
    default_type  application/octet-stream;
    sendfile      on;
    keepalive_timeout 65;

    lua_shared_dict news_cache 10m;
    lua_shared_dict article_cache 20m;
    lua_package_path "/etc/nginx/lua/?.lua;;";

    server {
        listen 80;
        server_name _;

        resolver 8.8.8.8 8.8.4.4 ipv6=off;
        resolver_timeout 5s;

        location = / {
            return 301 /news;
        }

        location /news {
            content_by_lua_file /etc/nginx/lua/handlers/index.lua;
        }

        location /news/article {
            content_by_lua_file /etc/nginx/lua/handlers/article.lua;
        }

        location /news/choose_edition {
            content_by_lua_file /etc/nginx/lua/handlers/choose_edition.lua;
        }

        error_page 500 502 503 504 /50x.html;
        location = /50x.html {
            root /usr/share/nginx/html;
            internal;
        }
    }
}
